[Unit]
Description=FRP tunnel for GPT-SoVITS conversion backend
After=network-online.target web-convert-local.service
Wants=network-online.target
Requires=web-convert-local.service

[Service]
Type=simple
ExecStart=/home/z/.local/bin/frp tcp 8090 18090
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
